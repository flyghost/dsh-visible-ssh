{
  "name": "dsh-visible-ssh",
  "version": "0.0.1",
  "private": true,
  "description": "Drive a remote host through a shared tmux pane, so the human watching that pane sees every command the model runs and can take it over at any time.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "src/",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "npm run build && tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../test/run.mjs",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "dsh-visible-ssh-engine-win32-x64": "^0.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.2.0-rc.2",
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
